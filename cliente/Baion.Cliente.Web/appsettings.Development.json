{
  // Todo lo necesario para levantar el panel en local:
  //
  //   1. Levanta el orquestador (http://localhost:5199).
  //   2. dotnet run --project cliente/Baion.Cliente.Web
  //   3. Abre http://localhost:5100 y entra con las credenciales del bootstrap del orquestador:
  //        organización: dev
  //        correo:       admin@baion.local
  //        contraseña:   desarrollo-local-cambiar
  //
  // Los estilos se compilan solos en el build (Tailwind vía MSBuild). Para recompilarlos al vuelo
  // mientras editas componentes, en otra terminal:
  //   cd cliente/Baion.Cliente.Web && npm run css:watch
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "BaionApi": {
    "BaseAddress": "http://localhost:5199",
    "TimeoutSeconds": 30
  }
}
