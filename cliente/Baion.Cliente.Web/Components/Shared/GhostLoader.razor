@* Estado de carga: los mismos ticks fantasma de las barras recorriendo el riel. Se usa este patrón
   y no un shimmer gris porque es lo que hace que el sistema se lea «de datos». *@

<div class="space-y-3" role="status" aria-label="@Descripcion">
    @for (var fila = 0; fila < Filas; fila++)
    {
        <div class="h-2 overflow-hidden rounded-bar bg-track">
            <div class="h-full w-1/3 bg-ghost-ticks animate-ghost-sweep"></div>
        </div>
    }
    <span class="sr-only">@Descripcion</span>
</div>

@code {
    /// <summary>Cuántos rieles se dibujan; uno por cada bloque de contenido que se espera.</summary>
    [Parameter]
    public int Filas { get; set; } = 3;

    [Parameter]
    public string Descripcion { get; set; } = "Cargando…";
}
