@* Pestaña «Servicios» de un servidor: lista con buscador. Cada fila abre la pantalla de detalle del
   servicio, donde viven la ficha, los logs y el control. Aquí no se carga nada más que la lista. *@

@inject IBaionApiClient Api
@inject NavigationManager Navigation

<div class="flex flex-wrap items-center gap-2">
    <SearchPill @bind-Valor="_filtro" OnBuscar="BuscarAsync" Placeholder="Nombre del servicio" />
    <button type="button" class="baion-button-icon @_ratonActualizar.Clase" title="Actualizar" aria-label="Actualizar"
            disabled="@_cargando" @onclick="CargarAsync" @attributes="this.EventosRaton(_ratonActualizar)">
        <Icon Nombre="refresh-cw" Tamano="20" />
    </button>
</div>

<div class="mt-6">
    <AlertMessage Mensaje="@_error" />

    @if (_cargando && _servicios is null)
    {
        <GhostLoader Filas="6" Descripcion="Cargando los servicios…" />
    }
    else if (_error is not null && _servicios is null)
    {
        <EmptyState Icono="circle-alert"
                    Titulo="No se pudieron cargar los servicios"
                    Descripcion="@_error">
            <Accion>
                <button type="button" class="baion-button @_ratonReintentar.Clase" @onclick="CargarAsync"
                        @attributes="this.EventosRaton(_ratonReintentar)">Reintentar</button>
            </Accion>
        </EmptyState>
    }
    else if (Servicios.Count == 0)
    {
        <EmptyState Icono="sliders-horizontal"
                    Titulo="No hay servicios que mostrar"
                    Descripcion="@(string.IsNullOrWhiteSpace(_filtroActivo)
                        ? "El agente no reportó ningún servicio del sistema."
                        : "Ningún servicio coincide con el filtro; prueba con otro texto.")" />
    }
    else
    {
        <div class="baion-card overflow-hidden">
            <div class="overflow-x-auto">
                <table class="baion-table">
                    <thead>
                        <tr>
                            <th>Servicio</th>
                            <th>Estado</th>
                            <th>Arranque</th>
                            <th><span class="sr-only">Abrir</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var servicio in Servicios)
                        {
                            <tr class="cursor-pointer" @onclick="() => Abrir(servicio.Id)">
                                <td>
                                    <a class="text-title text-ink" href="@Ruta(servicio.Id)" @onclick:stopPropagation="true">@servicio.DisplayName</a>
                                    <div class="mt-1 font-mono text-label text-muted">@servicio.Id</div>
                                </td>
                                <td><ServiceStateBadge Estado="@servicio.State" /></td>
                                <td class="text-muted">@ServiceStates.StartupLabel(servicio.StartupMode)</td>
                                <td class="text-right text-muted">
                                    <Icon Nombre="chevron-right" Tamano="16" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>Servidor cuyos servicios se listan; lo pasa la página de detalle del servidor.</summary>
    [Parameter, EditorRequired]
    public Guid ServerId { get; set; }

    private readonly EstadoRaton _ratonActualizar = new();
    private readonly EstadoRaton _ratonReintentar = new();

    private IReadOnlyList<ServiceSummary>? _servicios;
    private string? _filtro;
    private string? _filtroActivo;
    private string? _error;
    private bool _cargando = true;

    private IReadOnlyList<ServiceSummary> Servicios => _servicios ?? [];

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        _error = null;
        _filtroActivo = string.IsNullOrWhiteSpace(_filtro) ? null : _filtro!.Trim();

        var resultado = await Api.GetServerServicesAsync(ServerId, _filtroActivo, CancellationToken.None);

        if (resultado is { IsSuccess: true, Value: { } servicios })
        {
            _servicios = servicios;
        }
        else
        {
            _servicios = null;
            _error = ServiceStates.FriendlyError(resultado.ErrorCode, resultado.ErrorMessage);
        }

        _cargando = false;
    }

    private async Task BuscarAsync() => await CargarAsync();

    private void Abrir(string serviceId) => Navigation.NavigateTo(Ruta(serviceId));

    private string Ruta(string serviceId) => $"/servidores/{ServerId}/servicios/{Uri.EscapeDataString(serviceId)}";
}
