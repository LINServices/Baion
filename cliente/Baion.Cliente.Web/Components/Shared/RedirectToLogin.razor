@inject NavigationManager Navigation

@code {
    /// <summary>Manda al login conservando a dónde quería ir la persona, para volver tras autenticarse.</summary>
    protected override void OnInitialized()
    {
        var destino = Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.NavigateTo($"login?volverA={destino}", forceLoad: true);
    }
}
