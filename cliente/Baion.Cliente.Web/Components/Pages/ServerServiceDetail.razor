@page "/servidores/{ServerId:guid}/servicios/{ServiceId}"
@attribute [Authorize]

@inject IBaionApiClient Api

<PageTitle>@Titulo · Baion</PageTitle>

<PageHeader Seccion="@Seccion" Titulo="@Titulo">
    <Acciones>
        @if (_detalle is not null)
        {
            <ServiceStateBadge Estado="@_detalle.State" />
        }
        <a class="baion-button-ghost" href="@RutaVolver">
            <Icon Nombre="chevron-left" Tamano="14" />
            Volver a servicios
        </a>
    </Acciones>
</PageHeader>

<AlertMessage Mensaje="@_error" />

@if (_cargando)
{
    <GhostLoader Filas="4" Descripcion="Cargando el servicio…" />
}
else if (_detalle is null)
{
    <EmptyState Icono="sliders-horizontal"
                Titulo="No se encontró el servicio"
                Descripcion="Puede que el agente ya no lo reporte o que el enlace esté equivocado.">
        <Accion>
            <a class="baion-button" href="@RutaVolver">Ir a la lista de servicios</a>
        </Accion>
    </EmptyState>
}
else
{
    <div class="baion-card p-6">
        @if (_esAdmin && HayAcciones)
        {
            <div class="mb-6 flex flex-wrap items-center gap-2 border-b border-line pb-6">
                @if (_detalle.State != "running")
                {
                    <button type="button" class='baion-button @_ratones["start"].Clase' disabled="@_ejecutandoAccion"
                            @onclick='() => PulsarAccionAsync("start")' @attributes='this.EventosRaton(_ratones["start"])'>Arrancar</button>
                }
                @if (_detalle.State == "running")
                {
                    <button type="button" class='baion-button-ghost @_ratones["restart"].Clase' disabled="@_ejecutandoAccion"
                            @onclick='() => PulsarAccionAsync("restart")' @attributes='this.EventosRaton(_ratones["restart"])'>Reiniciar</button>
                    <button type="button" class='baion-button-danger @_ratones["stop"].Clase' disabled="@_ejecutandoAccion"
                            @onclick='() => PulsarAccionAsync("stop")' @attributes='this.EventosRaton(_ratones["stop"])'>Detener</button>
                }
                @if (_detalle.StartupMode != "automatic")
                {
                    <button type="button" class='baion-button-ghost @_ratones["enable"].Clase' disabled="@_ejecutandoAccion"
                            @onclick='() => PulsarAccionAsync("enable")' @attributes='this.EventosRaton(_ratones["enable"])'>Habilitar arranque</button>
                }
                @if (_detalle.StartupMode != "disabled")
                {
                    <button type="button" class='baion-button-danger @_ratones["disable"].Clase' disabled="@_ejecutandoAccion"
                            @onclick='() => PulsarAccionAsync("disable")' @attributes='this.EventosRaton(_ratones["disable"])'>Deshabilitar arranque</button>
                }
                @if (_ejecutandoAccion)
                {
                    <span class="flex items-center gap-2 text-label text-muted">
                        <span class="baion-chip-dot animate-pulse bg-ink" aria-hidden="true"></span>
                        Aplicando…
                    </span>
                }
            </div>
        }

        <AlertMessage Mensaje="@_errorDetalle" />

        <dl class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <DetailField Etiqueta="Estado">
                <ServiceStateBadge Estado="@_detalle.State" />
            </DetailField>
            <DetailField Etiqueta="Estado del sistema">
                <span class="font-mono text-label text-ink-2">@_detalle.RawState@(_detalle.SubState is null ? string.Empty : $" · {_detalle.SubState}")</span>
            </DetailField>
            <DetailField Etiqueta="Arranque">
                @ServiceStates.StartupLabel(_detalle.StartupMode)
            </DetailField>
            <DetailField Etiqueta="PID">
                <span class="tabular-nums">@(_detalle.MainProcessId?.ToString() ?? "—")</span>
            </DetailField>
            <DetailField Etiqueta="Memoria">
                <span class="tabular-nums">@(_detalle.MemoryBytes is long memoria ? NumberFormat.Bytes(memoria) : "—")</span>
            </DetailField>
            <DetailField Etiqueta="Activo desde">
                <span title="@TimeFormat.Absolute(_detalle.ActiveSince)">@TimeFormat.Relative(_detalle.ActiveSince)</span>
            </DetailField>
            <DetailField Etiqueta="Código de salida">
                <span class="font-mono tabular-nums @(_detalle.ExitCode is int and not 0 ? "text-danger" : "text-ink")">@(_detalle.ExitCode?.ToString() ?? "—")</span>
            </DetailField>
            <DetailField Etiqueta="Ruta">
                <span class="break-all font-mono text-label text-ink-2">@(_detalle.ExecPath ?? "—")</span>
            </DetailField>
        </dl>

        @if (!string.IsNullOrWhiteSpace(_detalle.Description))
        {
            <p class="mt-6 max-w-[62ch] text-body text-ink-2">@_detalle.Description</p>
        }

        @if (_detalle.Dependencies.Count > 0)
        {
            <div class="mt-6">
                <p class="text-label text-muted">Depende de</p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                    @foreach (var dependencia in _detalle.Dependencies)
                    {
                        <span class="baion-chip font-mono">@dependencia</span>
                    }
                </div>
            </div>
        }
    </div>

    <section class="mt-10">
        <h2 class="mb-4 text-heading text-ink">Registro</h2>

        <div class="baion-card p-6">
            <div class="flex flex-wrap items-end gap-3">
                <div>
                    <label class="baion-label" for="log-lineas">Líneas</label>
                    <SelectShell Class="mt-2 w-32">
                        <select id="log-lineas" class="baion-select tabular-nums" @bind="_maxLineas">
                            <option value="100">100</option>
                            <option value="200">200</option>
                            <option value="500">500</option>
                            <option value="1000">1000</option>
                            <option value="2000">2000</option>
                        </select>
                    </SelectShell>
                </div>
                <div>
                    <label class="baion-label" for="log-desde">Desde (UTC)</label>
                    <input id="log-desde" type="datetime-local" class="baion-input mt-2" @bind="_desde" />
                </div>
                <button type="button" class="baion-button-ghost @_ratonLogs.Clase" disabled="@_cargandoLogs"
                        @onclick="CargarLogsAsync" @attributes="this.EventosRaton(_ratonLogs)">
                    <Icon Nombre="terminal" Tamano="14" />
                    @(_cargandoLogs ? "Cargando…" : "Cargar logs")
                </button>
            </div>

            @if (_errorLogs is not null)
            {
                <p class="mt-4 flex items-start gap-2 text-label text-danger" role="alert">
                    <span class="mt-px shrink-0" aria-hidden="true"><Icon Nombre="circle-alert" Tamano="14" /></span>
                    @_errorLogs
                </p>
            }

            @if (_logs is not null)
            {
                @if (_logs.Truncated)
                {
                    <p class="mt-4 flex items-start gap-2 text-label text-warn">
                        <span class="mt-px shrink-0" aria-hidden="true"><Icon Nombre="circle-alert" Tamano="14" /></span>
                        El agente recortó el resultado para no pasarse del tamaño máximo de trama; pide menos líneas o acota «Desde».
                    </p>
                }

                @if (_logs.Lines.Count == 0)
                {
                    <p class="mt-4 text-body text-muted">No hay líneas de log para el intervalo pedido.</p>
                }
                else
                {
                    <div class="baion-output mt-4 space-y-1 font-mono">
                        @foreach (var linea in _logs.Lines)
                        {
                            <div class="whitespace-pre-wrap break-words">
                                @if (linea.Timestamp is DateTimeOffset marca)
                                {
                                    <span class="text-muted">@marca.ToString("dd/MM HH:mm:ss") </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(linea.Level))
                                {
                                    <span class="text-ink">[@linea.Level] </span>
                                }
                                @linea.Message
                            </div>
                        }
                    </div>
                }
            }
            else if (_errorLogs is null)
            {
                <p class="mt-4 text-body text-muted">Elige cuántas líneas quieres y pulsa «Cargar logs» para traerlas del agente.</p>
            }
        </div>
    </section>
}

<ConfirmDialog @bind-Visible="_confirmVisible"
               Titulo="@_confirmTitulo"
               Descripcion="@_confirmDescripcion"
               Destructivo="@_confirmDestructivo"
               TextoConfirmar="Continuar"
               OnConfirmar="EjecutarAccionAsync" />

@code {
    /// <summary>Servidor al que pertenece el servicio; llega en la ruta.</summary>
    [Parameter]
    public Guid ServerId { get; set; }

    /// <summary>
    /// Identificador del servicio tal cual lo da el agente (p. ej. <c>nginx.service</c>); llega en la ruta
    /// como un único segmento y Blazor lo entrega ya decodificado.
    /// </summary>
    [Parameter]
    public string ServiceId { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private readonly EstadoRatonMapa _ratones = new();
    private readonly EstadoRaton _ratonLogs = new();

    private Models.ServiceDetail? _detalle;
    private string? _servidorNombre;
    private string? _error;
    private string? _errorDetalle;
    private bool _cargando = true;
    private bool _esAdmin;
    private bool _ejecutandoAccion;

    private ServiceLogPage? _logs;
    private string? _errorLogs;
    private bool _cargandoLogs;
    private int _maxLineas = 200;
    private DateTime? _desde;

    private bool _confirmVisible;
    private string? _accionPendiente;
    private string _confirmTitulo = string.Empty;
    private string? _confirmDescripcion;
    private bool _confirmDestructivo;

    private string Titulo => _detalle?.DisplayName ?? ServiceId;

    // El eyebrow sitúa el servicio en su servidor, que es el contexto que el título no puede dar.
    private string Seccion => string.IsNullOrWhiteSpace(_servidorNombre) ? "Servicio" : $"Servicio en {_servidorNombre}";

    private string RutaVolver => $"/servidores/{ServerId}?vista=servicios";

    private bool HayAcciones => _detalle is not null;

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is not null)
        {
            var estado = await EstadoAutenticacion;
            _esAdmin = estado.User.IsInRole("Admin");
        }
    }

    // Saltar de un servicio a otro reutiliza el componente y solo cambia el parámetro de ruta.
    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _error = null;
        _errorDetalle = null;
        _logs = null;
        _errorLogs = null;
        _desde = null;

        var servidor = await Api.GetServerAsync(ServerId, CancellationToken.None);
        _servidorNombre = servidor.Value?.Server.Name;

        await CargarDetalleAsync();

        _cargando = false;
    }

    private async Task CargarDetalleAsync()
    {
        var resultado = await Api.GetServerServiceAsync(ServerId, ServiceId, CancellationToken.None);

        if (resultado is { IsSuccess: true, Value: { } detalle })
        {
            _detalle = detalle;
            _error = null;
        }
        else
        {
            _detalle = null;
            _error = ServiceStates.FriendlyError(resultado.ErrorCode, resultado.ErrorMessage);
        }
    }

    private async Task CargarLogsAsync()
    {
        if (_detalle is null)
        {
            return;
        }

        _cargandoLogs = true;
        _errorLogs = null;

        var desde = _desde is DateTime valor
            ? new DateTimeOffset(DateTime.SpecifyKind(valor, DateTimeKind.Utc), TimeSpan.Zero)
            : (DateTimeOffset?)null;

        var resultado = await Api.GetServerServiceLogsAsync(ServerId, _detalle.Id, _maxLineas, desde, CancellationToken.None);

        if (resultado is { IsSuccess: true, Value: { } pagina })
        {
            _logs = pagina;
        }
        else
        {
            _logs = null;
            _errorLogs = ServiceStates.FriendlyError(resultado.ErrorCode, resultado.ErrorMessage);
        }

        _cargandoLogs = false;
    }

    private async Task PulsarAccionAsync(string accion)
    {
        _accionPendiente = accion;

        if (accion is "stop" or "restart" or "disable")
        {
            (_confirmTitulo, _confirmDescripcion, _confirmDestructivo) = TextoConfirmacion(accion);
            _confirmVisible = true;
            return;
        }

        await EjecutarAccionAsync();
    }

    private async Task EjecutarAccionAsync()
    {
        if (_accionPendiente is null || _detalle is null)
        {
            return;
        }

        _ejecutandoAccion = true;
        _errorDetalle = null;

        var resultado = await Api.ControlServerServiceAsync(ServerId, _detalle.Id, _accionPendiente, CancellationToken.None);

        _ejecutandoAccion = false;
        _accionPendiente = null;

        if (resultado is { IsSuccess: true, Value: { } detalle })
        {
            _detalle = detalle;
        }
        else
        {
            _errorDetalle = ServiceStates.FriendlyError(resultado.ErrorCode, resultado.ErrorMessage);
        }
    }

    private (string Titulo, string? Descripcion, bool Destructivo) TextoConfirmacion(string accion) => accion switch
    {
        "stop" => ("Detener el servicio", $"Se detendrá «{Nombre}» en el servidor; puede afectar a lo que dependa de él.", true),
        "restart" => ("Reiniciar el servicio", $"Se reiniciará «{Nombre}»: quedará unos segundos sin servicio.", false),
        "disable" => ("Deshabilitar el arranque", $"«{Nombre}» no volverá a arrancar al iniciar la máquina.", true),
        _ => ("Confirmar la acción", null, false)
    };

    private string Nombre => _detalle?.DisplayName ?? _detalle?.Id ?? "el servicio";
}
