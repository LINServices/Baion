@using System.ComponentModel.DataAnnotations
@using LIN.Cloud.Enterprise.Baion.Cliente.Web.Dtos.ServerGroups

@inject IBaionApiClient Api
@inject NavigationManager Navigation

<div class="baion-card p-6">
    <div class="mb-6 flex items-start justify-between gap-4">
        <div class="flex items-center gap-2">
            <span class="text-ink" aria-hidden="true"><Icon Nombre="play" /></span>
            <h2 class="text-title text-ink">Ejecutar script</h2>
        </div>
        <button type="button" class="baion-button-icon @_ratonCerrar.CssClass" title="Cerrar" aria-label="Cerrar"
                @onclick="Cancelar" @attributes="this.MouseEvents(_ratonCerrar)">
            <Icon Nombre="x" Tamano="20" />
        </button>
    </div>

    <AlertMessage Mensaje="@_error" />

    @if (_cargandoServidores)
    {
        <GhostLoader Filas="2" Descripcion="Buscando destinos compatibles…" />
    }
    else if (_compatibles.Count == 0 && !GruposCompatibles.Any())
    {
        @* El ámbar del sistema solo vive en el icono: un bloque de color aquí está prohibido. *@
        <div class="flex items-start gap-2 rounded-xl border border-line bg-surface-alt px-4 py-3 text-body text-ink-2" role="status">
            <span class="mt-px shrink-0 text-warn" aria-hidden="true"><Icon Nombre="circle-alert" Tamano="14" /></span>
            <span>
                Ningún servidor conectado puede ejecutar este script. Necesita un agente en línea sobre @ScriptRuntimes.SupportedPlatforms(Runtime).
                @if (_incompatibles > 0)
                {
                    <span>Hay @_incompatibles servidor@(_incompatibles == 1 ? "" : "es") descartado@(_incompatibles == 1 ? "" : "s") por plataforma o por estar desconectado@(_incompatibles == 1 ? "" : "s").</span>
                }
            </span>
        </div>
    }
    else if (_resultadoLote is not null)
    {
        <BatchResultCard Resultado="_resultadoLote" />
    }
    else
    {
        <EditForm Model="_entrada" OnValidSubmit="LanzarAsync">
            <DataAnnotationsValidator />

            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label class="baion-label" for="destino">Destino</label>
                    <SelectShell Class="mt-2">
                        <InputSelect id="destino" @bind-Value="_destino" @bind-Value:after="AlCambiarDestinoAsync" class="baion-select">
                            @if (_compatibles.Count > 0)
                            {
                                <optgroup label="Servidores">
                                    @foreach (var servidor in _compatibles)
                                    {
                                        <option value="@(PrefijoServidor + servidor.Id)">@servidor.Name (@ScriptRuntimes.PlatformLabel(servidor.Platform))</option>
                                    }
                                </optgroup>
                            }
                            @if (_grupos.Count > 0)
                            {
                                <optgroup label="Grupos">
                                    @foreach (var grupo in _grupos)
                                    {
                                        var compatibles = CompatiblesDe(grupo);
                                        <option value="@(PrefijoGrupo + grupo.Id)" disabled="@(compatibles == 0)">@grupo.Name — @grupo.MemberCount servidor@(grupo.MemberCount == 1 ? "" : "es") · @compatibles compatible@(compatibles == 1 ? "" : "s")</option>
                                    }
                                </optgroup>
                            }
                        </InputSelect>
                    </SelectShell>
                    @if (_grupoSeleccionado is not null)
                    {
                        <div class="mt-2 text-label text-ink-2">
                            <p class="flex items-start gap-1.5">
                                @if (_noCompatibles > 0)
                                {
                                    <span class="mt-px shrink-0 text-warn" aria-hidden="true"><Icon Nombre="circle-alert" Tamano="14" /></span>
                                }
                                <span>
                                    Se ejecutará en @_compatiblesGrupo de @_grupoSeleccionado.Members.Count servidor@(_grupoSeleccionado.Members.Count == 1 ? "" : "es")@(_noCompatibles > 0 ? $" ({_noCompatibles} no compatible{(_noCompatibles == 1 ? "" : "s")} con {ScriptRuntimes.Label(Runtime)})" : "").
                                </span>
                            </p>
                            @if (_deshabilitados > 0 || _desconectados > 0)
                            {
                                <p class="mt-1 text-muted">
                                    @if (_deshabilitados > 0)
                                    {
                                        <span>@_deshabilitados deshabilitado@(_deshabilitados == 1 ? "" : "s") se omitirá@(_deshabilitados == 1 ? "" : "n"). </span>
                                    }
                                    @if (_desconectados > 0)
                                    {
                                        <span>@_desconectados sin agente conectado fallará@(_desconectados == 1 ? "" : "n").</span>
                                    }
                                </p>
                            }
                        </div>
                    }
                </div>

                <div>
                    <label class="baion-label" for="modo">Modo</label>
                    <SelectShell Class="mt-2">
                        <InputSelect id="modo" @bind-Value="_entrada.Mode" class="baion-select">
                            <option value="attached">Adjunto — espera el resultado</option>
                            <option value="detached">Desatendido — lanza y no espera</option>
                        </InputSelect>
                    </SelectShell>
                    @if (_entrada.Mode == "detached")
                    {
                        <p class="mt-2 flex items-start gap-1.5 text-label text-ink-2">
                            <span class="mt-px shrink-0 text-warn" aria-hidden="true"><Icon Nombre="circle-alert" Tamano="14" /></span>
                            No se recogerá su salida ni su código de salida.
                        </p>
                    }
                </div>
            </div>

            <details class="mt-6">
                <summary class="cursor-pointer text-body text-ink-2 transition-colors duration-150 ease-brand hover:text-ink">Opciones avanzadas</summary>

                <div class="mt-4 grid gap-5 sm:grid-cols-2">
                    <div>
                        <label class="baion-label" for="timeout">Timeout (s)</label>
                        <InputNumber id="timeout" @bind-Value="_entrada.TimeoutSeconds" class="baion-input mt-2 tabular-nums" placeholder="@DefaultTimeoutSeconds.ToString()" />
                        <ValidationMessage For="() => _entrada.TimeoutSeconds" class="mt-2 text-label text-danger" />
                        <p class="mt-2 text-label text-muted">Vacío usa el del script (@DefaultTimeoutSeconds s).</p>
                    </div>

                    <div>
                        <label class="baion-label" for="directorio">Directorio de trabajo</label>
                        <InputText id="directorio" @bind-Value="_entrada.WorkingDirectory" class="baion-input mt-2" placeholder="Opcional" />
                    </div>

                    <div class="sm:col-span-2">
                        <label class="baion-label" for="entorno">Variables de entorno</label>
                        <InputTextArea id="entorno" @bind-Value="_entrada.Environment" rows="3" class="baion-textarea mt-2"
                                       spellcheck="false" placeholder="CLAVE=valor (una por línea)" />
                        <ValidationMessage For="() => _entrada.Environment" class="mt-2 text-label text-danger" />
                    </div>
                </div>
            </details>

            <div class="mt-6 flex items-center gap-2">
                <button type="submit" class="baion-button @_ratonLanzar.CssClass" disabled="@(_lanzando || _cargandoGrupo || _destino.Length == 0)"
                        @attributes="this.MouseEvents(_ratonLanzar)">
                    @(_lanzando ? "Lanzando…" : "Ejecutar ahora")
                </button>
                <button type="button" class="baion-button-ghost @_ratonCancelar.CssClass" @onclick="Cancelar" disabled="@_lanzando"
                        @attributes="this.MouseEvents(_ratonCancelar)">Cancelar</button>
            </div>
        </EditForm>
    }
</div>

@code {
    private readonly EntradaEjecucion _entrada = new();
    private readonly MouseState _ratonCerrar = new();
    private readonly MouseState _ratonLanzar = new();
    private readonly MouseState _ratonCancelar = new();

    private const string PrefijoServidor = "s:";
    private const string PrefijoGrupo = "g:";

    private IReadOnlyList<ServerSummary> _compatibles = [];
    private IReadOnlyList<ServerGroupSummary> _grupos = [];
    private ServerGroupDetail? _grupoSeleccionado;
    private DispatchGroupResult? _resultadoLote;
    private string _destino = string.Empty;
    private int _compatiblesGrupo;
    private int _noCompatibles;
    private int _deshabilitados;
    private int _desconectados;
    private bool _cargandoGrupo;
    private int _incompatibles;
    private string? _error;
    private bool _cargandoServidores = true;
    private bool _lanzando;

    [Parameter, EditorRequired]
    public Guid ScriptId { get; set; }

    [Parameter, EditorRequired]
    public string Runtime { get; set; } = string.Empty;

    [Parameter]
    public int DefaultTimeoutSeconds { get; set; } = 300;

    [Parameter]
    public EventCallback Cerrado { get; set; }

    private IEnumerable<ServerGroupSummary> GruposCompatibles => _grupos.Where(grupo => CompatiblesDe(grupo) > 0);

    protected override async Task OnInitializedAsync()
    {
        var tareaServidores = Api.GetServersAsync(CancellationToken.None);
        var tareaGrupos = Api.GetServerGroupsAsync(CancellationToken.None);
        await Task.WhenAll(tareaServidores, tareaGrupos);

        var resultado = await tareaServidores;
        var servidores = resultado.Value ?? [];

        // Que falle el listado de grupos no impide lanzar sobre un servidor suelto.
        _grupos = (await tareaGrupos).Value ?? [];

        // Se descartan los que no soportan el intérprete y los que no tienen agente conectado:
        // ofrecerlos solo llevaría a un rechazo del orquestador con el formulario ya enviado.
        _compatibles = servidores.Where(EsElegible).ToList();
        _incompatibles = servidores.Count - _compatibles.Count;

        _destino = _compatibles.Count > 0
            ? PrefijoServidor + _compatibles[0].Id
            : GruposCompatibles.Select(grupo => PrefijoGrupo + grupo.Id).FirstOrDefault() ?? string.Empty;

        _error = resultado.ErrorMessage;
        _cargandoServidores = false;

        await AlCambiarDestinoAsync();
    }

    // Compatibles de un grupo según plataforma; el orquestador revalida siempre.
    private int CompatiblesDe(ServerGroupSummary grupo)
    {
        return (ScriptRuntimes.IsSupported(Runtime, "linux") ? grupo.LinuxCount : 0)
            + (ScriptRuntimes.IsSupported(Runtime, "windows") ? grupo.WindowsCount : 0);
    }

    private bool TryGetGrupoId(out Guid grupoId)
    {
        grupoId = Guid.Empty;
        return _destino.StartsWith(PrefijoGrupo, StringComparison.Ordinal)
            && Guid.TryParse(_destino[PrefijoGrupo.Length..], out grupoId);
    }

    private async Task AlCambiarDestinoAsync()
    {
        _grupoSeleccionado = null;

        if (!TryGetGrupoId(out var grupoId))
            return;

        _cargandoGrupo = true;
        var resultado = await Api.GetServerGroupAsync(grupoId, CancellationToken.None);
        _cargandoGrupo = false;

        if (resultado.Value is not { } grupo)
        {
            _error = resultado.ErrorMessage;
            return;
        }

        _error = null;
        _grupoSeleccionado = grupo;

        var compatibles = grupo.Members.Where(miembro => ScriptRuntimes.IsSupported(Runtime, miembro.Platform)).ToList();
        _compatiblesGrupo = compatibles.Count;
        _noCompatibles = grupo.Members.Count - compatibles.Count;
        _deshabilitados = compatibles.Count(miembro => miembro.Status == "disabled");
        _desconectados = compatibles.Count(miembro => miembro.Status != "disabled" && miembro.Status != "online");
    }

    private bool EsElegible(ServerSummary servidor)
    {
        return servidor.Status == "online" && ScriptRuntimes.IsSupported(Runtime, servidor.Platform);
    }

    private async Task LanzarAsync()
    {
        if (!TryParseEntorno(_entrada.Environment, out var entorno, out var lineaInvalida))
        {
            _error = $"La línea «{lineaInvalida}» no tiene el formato CLAVE=valor.";
            return;
        }

        _lanzando = true;
        _error = null;

        if (TryGetGrupoId(out var grupoId))
        {
            await LanzarGrupoAsync(grupoId, entorno);
            return;
        }

        if (!_destino.StartsWith(PrefijoServidor, StringComparison.Ordinal)
            || !Guid.TryParse(_destino[PrefijoServidor.Length..], out var servidorId))
        {
            _lanzando = false;
            _error = "Elige un destino para la ejecución.";
            return;
        }

        var peticion = new DispatchScriptRequest(
            ScriptId,
            servidorId,
            _entrada.Mode,
            _entrada.TimeoutSeconds,
            string.IsNullOrWhiteSpace(_entrada.WorkingDirectory) ? null : _entrada.WorkingDirectory.Trim(),
            entorno.Count == 0 ? null : entorno);

        var resultado = await Api.DispatchAsync(peticion, CancellationToken.None);

        _lanzando = false;

        if (resultado is not { IsSuccess: true, Value: ScriptExecutionDispatched despacho })
        {
            _error = resultado.ErrorMessage;
            return;
        }

        // Se va al detalle: es donde la ejecución se sigue en vivo hasta que termina.
        Navigation.NavigateTo($"/ejecuciones/{despacho.ExecutionId}");
    }

    private async Task LanzarGrupoAsync(Guid grupoId, Dictionary<string, string> entorno)
    {
        var peticion = new DispatchGroupRequest(
            ScriptId,
            grupoId,
            _entrada.Mode,
            _entrada.TimeoutSeconds,
            string.IsNullOrWhiteSpace(_entrada.WorkingDirectory) ? null : _entrada.WorkingDirectory.Trim(),
            entorno.Count == 0 ? null : entorno);

        var resultado = await Api.DispatchGroupAsync(peticion, CancellationToken.None);

        _lanzando = false;

        if (resultado.Value is not { } lote)
        {
            _error = resultado.ErrorMessage;
            return;
        }

        // Si todo salió según lo previsto se va directo al lote; con omitidos o fallidos se explican antes.
        if (lote.SkippedIncompatible + lote.SkippedDisabled + lote.Failed == 0)
        {
            Navigation.NavigateTo($"/ejecuciones/lote/{lote.BatchId}");
            return;
        }

        _resultadoLote = lote;
    }

    private async Task Cancelar()
    {
        await Cerrado.InvokeAsync();
    }

    private static bool TryParseEntorno(string? texto, out Dictionary<string, string> entorno, out string lineaInvalida)
    {
        entorno = [];
        lineaInvalida = string.Empty;

        if (string.IsNullOrWhiteSpace(texto))
            return true;

        foreach (var linea in texto.Split('\n'))
        {
            var limpia = linea.Trim();

            if (limpia.Length == 0 || limpia.StartsWith('#'))
                continue;

            var separador = limpia.IndexOf('=');

            if (separador <= 0)
            {
                lineaInvalida = limpia;
                return false;
            }

            entorno[limpia[..separador].Trim()] = limpia[(separador + 1)..].Trim();
        }

        return true;
    }

    private sealed class EntradaEjecucion
    {
        public string Mode { get; set; } = "attached";

        [Range(1, 86_400, ErrorMessage = "El timeout debe estar entre 1 segundo y 24 horas.")]
        public int? TimeoutSeconds { get; set; }

        public string? WorkingDirectory { get; set; }

        public string? Environment { get; set; }
    }
}
