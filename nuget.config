<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="LI" value="https://nuget.linplatform.com/nuget" />
  </packageSources>

  <!-- Requerido por la administración central de paquetes (NU1507) y evita traer
       paquetes publicos desde el feed interno, o viceversa. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="LI">
      <package pattern="LIN.*" />
      <package pattern="Global.*" />
      <package pattern="Http.Utils" />
    </packageSource>
  </packageSourceMapping>

</configuration>
