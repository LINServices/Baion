<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="LI" value="https://nuget.linplatform.com/nuget" />
  </packageSources>

  <!-- Requerido por la administración central de paquetes (NU1507) y evita traer
       paquetes publicos desde el feed interno, o viceversa.
       Excepción: Http.Utils 6.4+ arrastra LIN.Access.Configurations 2026.3.28.1 y
       Global.Http 3.9.0, que LIN publica en nuget.org y todavía no están en el feed
       interno. Se mapean por nombre exacto a nuget.org; el resto de LIN.* / Global.*
       sigue saliendo solo del feed interno. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="LIN.Access.Configurations" />
      <package pattern="Global.Http" />
    </packageSource>
    <packageSource key="LI">
      <package pattern="LIN.*" />
      <package pattern="Global.*" />
      <package pattern="Http.Utils" />
    </packageSource>
  </packageSourceMapping>

</configuration>
