{
  // Todo lo necesario para levantar el orquestador en local. Solo sobrescribe lo que cambia
  // respecto a appsettings.json; el resto de valores se hereda de allí.
  //
  //   dotnet run --project src/Orchestrator/Baion.Orchestrator.Presentacion
  //
  // Queda escuchando en http://localhost:5199 (ver Properties/launchSettings.json).
  // Antes del primer arranque hay que crear el esquema:
  //   dotnet ef database update -p src/Orchestrator/Baion.Orchestrator.Persistence -s src/Orchestrator/Baion.Orchestrator.Persistence
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // Subir a Information para ver el SQL que genera EF Core.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "ConnectionStrings": {
    // LocalDB viene con Visual Studio y con el SDK de SQL Server. Si prefieres un contenedor:
    // "Server=localhost,1433;Database=lin_baion;User Id=sa;Password=TuPassword1!;TrustServerCertificate=True"
    "BaionDatabase": "Server=localhost,1433;Database=baion;User Id=sa;Password=SqlServer!2026Dev;TrustServerCertificate=True;"
  },

  "Identity": {
    "Issuer": "baion-dev",
    "Audience": "baion-dev",

    // Solo para desarrollo. En producción va por variable de entorno.
    "SigningKey": "clave-de-desarrollo-solo-local-no-usar-en-produccion",
    "AccessTokenMinutes": 480,

    // Crea el tenant "dev" y su administrador en el primer arranque. Es idempotente:
    // a partir del segundo arranque no hace nada. Estas son las credenciales del panel.
    "Bootstrap": {
      "Enabled": true,
      "TenantName": "Baion Desarrollo",
      "TenantSlug": "dev",
      "AdminEmail": "admin@baion.local",
      "AdminDisplayName": "Administrador",
      "AdminPassword": "desarrollo-local-cambiar",
      "AdminRole": "Admin"
    }
  },

  "Orchestrator": {
    "InstanceId": "local",

    // Más frecuente que en producción para no esperar al depurar.
    "HeartbeatSeconds": 15,

    "MetricIngest": {
      "BatchWindowMilliseconds": 500
    },

    "Scheduler": {
      // Las tareas programadas se disparan casi al instante en lugar de cada 15 s.
      "TickSeconds": 5
    }
  },

  "RabbitMq": {
    // Con una sola instancia no hace falta. Para probar el enrutado entre instancias:
    //   docker run -d --name baion-rabbit -p 5672:5672 -p 15672:15672 rabbitmq:4-management-alpine
    // y levantar dos orquestadores con Enabled=true, puertos distintos e InstanceId distintos:
    //   ASPNETCORE_URLS=http://localhost:5299 RabbitMq__Enabled=true Orchestrator__InstanceId=local-b dotnet run ...
    "Enabled": false
  }
}
