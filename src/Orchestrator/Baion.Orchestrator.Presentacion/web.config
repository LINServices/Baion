<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config base para el despliegue en IIS (LIN Cloud IIS Push).

  Al publicar, el SDK Web transforma este archivo e inyecta el elemento
  <aspNetCore> con el processPath y los arguments correctos; lo que se define
  aquí (en especial <webSocket enabled="true" />) se conserva.

  El canal de agentes (/ws/agent) necesita WebSockets habilitados en IIS:
  sin <webSocket enabled="true" /> el módulo devuelve 400/404 en el upgrade.
-->
<configuration>
  <system.webServer>
    <webSocket enabled="true" />
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet"
                arguments=".\Baion.Orchestrator.Presentacion.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess" />
  </system.webServer>
</configuration>
