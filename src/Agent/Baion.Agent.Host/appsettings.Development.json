{
  // Todo lo necesario para levantar el agente en local:
  //
  //   1. Levanta el orquestador (escucha en http://localhost:5199).
  //   2. Consigue un token de instalación:
  //
  //      TOKEN=$(curl -s -X POST http://localhost:5199/api/auth/login \
  //        -H "Content-Type: application/json" \
  //        -d '{"tenantSlug":"dev","email":"admin@baion.local","password":"desarrollo-local-cambiar"}' \
  //        | grep -o '"accessToken":"[^"]*"' | cut -d'"' -f4)
  //
  //      curl -s -X POST http://localhost:5199/api/agents/enrollment-tokens \
  //        -H "Content-Type: application/json" -H "Authorization: Bearer $TOKEN" \
  //        -d '{"name":"local","defaultServerKind":"vps","expiresAt":null,"maxUses":null}'
  //
  //   3. Pega el token en EnrollmentToken y arranca:
  //      dotnet run --project src/Agent/Baion.Agent.Host
  //
  // Tras el primer enrolamiento el token deja de usarse: la credencial permanente queda en
  // StateDirectory. Para volver a enrolar la máquina desde cero, borra esa carpeta.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",

      // Subir a Debug para ver el detalle de cada ejecución y de la reconexión.
      "Baion.Agent": "Information"
    }
  },

  "Agent": {
    "OrchestratorUri": "ws://localhost:5199",

    // Pega aquí el token del paso 2. Se puede pasar también por variable de entorno:
    //   Agent__EnrollmentToken=... dotnet run --project src/Agent/Baion.Agent.Host
    "EnrollmentToken": "",

    // Ruta relativa al directorio del proyecto, para no escribir en %ProgramData% al depurar.
    // Está en .gitignore: borrarla equivale a reinstalar el agente.
    "StateDirectory": ".agent-state",

    // Reintentos cortos para no esperar al depurar.
    "MinReconnectSeconds": 1,
    "MaxReconnectSeconds": 10
  },

  "Metrics": {
    // Más frecuente que en producción para ver el panel moverse.
    "IntervalSeconds": 10
  },

  "Execution": {
    // Sin fijar, los scripts se materializan en la temporal del sistema.
    "WorkingRoot": "",
    "FallbackMaxConcurrentExecutions": 4
  }
}
